+  if (!t || !t.labelEl) return;
+  const lab = t.labelEl;
+  if (idx < 0) { lab.classList.remove('disabled'); return; }
+  const it = t.itemEls[idx];
+  const disabled = probeRingSeatDisabled(it);
+  lab.classList.toggle('disabled', disabled);
+  if (disabled) {
+    lab.textContent = toolLabel(it.tool) + ' · needs a valid selection';
+    const vp = viewportEl.getBoundingClientRect();
+    const lr = lab.getBoundingClientRect();
+    let shift = 0;
+    if (lr.left < vp.left + 8) shift = vp.left + 8 - lr.left;
+    else if (lr.right > vp.right - 8) shift = vp.right - 8 - lr.right;
+    if (shift) lab.style.left = (parseFloat(lab.style.left || '0') + shift) + 'px';
+  }
+};
+const probeBaseCloseToolRing = closeToolRing;
+closeToolRing = function (run) {
+  const t = toolRingActive;
+  if (run && t) {
+    const it = t.hoveredIndex >= 0 ? t.itemEls[t.hoveredIndex] : null;
+    if (probeRingSeatDisabled(it)) run = false;
+    if (t.precise && (!it || t.lastClientX === undefined)) run = false;
+  }
+  touchToolRingEl.classList.remove('precise');
+  const result = probeBaseCloseToolRing(run);
+  setTimeout(probeMaybeShowDirectHint, 900);
+  return result;
+};
+
+/* Help describes the actual two gesture grammars rather than promising that
+   a clipped ring still picks by travel direction. */
+const probeRingHelp = HELP_SECTIONS.find(s => s.title === 'Tool rings');
+if (probeRingHelp) {
+  probeRingHelp.lead = 'In open space: hold, flick by direction and lift. At a clipped screen edge: release over the visible tool. Return to the middle to cancel.';
+  const near = probeRingHelp.rows.find(r => r[1] === 'Near a border');
+  if (near) near[2] = 'In the centre, flick by direction as usual. At a clipped edge, release over a visible seat or its clear hit area. Between seats, in the middle or outside cancels quietly.';
+  const off = probeRingHelp.rows.find(r => r[1] === 'A hatched seat');
+  if (off) off[2] = 'It has nothing valid to work on. Aim at it to see why; release does not execute it.';
+}
+const probeUvHelp = HELP_SECTIONS.find(s => s.title === 'UV');
+if (probeUvHelp) {
+  const view = probeUvHelp.rows.find(r => r[1] === 'The 2D view');
+  if (view) view[2] = 'Full screen. Outliner switches directly between objects’ UVs; Materials and 3D-only controls step aside. The visible 3D button and the empty-space ring both return to the model.';
+}
+HELP_QUICKSTART.splice(4, 0, 'Drag the selected shape to move it. Two-finger tap switches Move, Rotate and Scale.');
+
+/* The second first-run hint appears after a completed ring gesture. It
+   teaches direct manipulation without turning the viewport into a tour. */
+function probeMaybeShowDirectHint() {
+  if (!firstHintEl || !hasLearned('hold') || hasLearned('direct-drag') ||
+      toolRingActive || uvViewObj || helpOverlayEl.classList.contains('show')) return;
+  const copy = firstHintEl.querySelector('span');
+  if (!copy) return;
+  copy.textContent = 'Drag a selection to move · two-finger tap switches tool';
+  firstHintEl.dataset.probeStep = 'direct';
+  firstHintEl.classList.remove('going');
+  firstHintEl.hidden = false;
+}
+const probeBaseDismissFirstHint = dismissFirstHint;
+dismissFirstHint = function (learn) {
+  const step = firstHintEl && firstHintEl.dataset.probeStep === 'direct' ? 'direct' : 'hold';
+  probeBaseDismissFirstHint(learn);
+  if (learn && step === 'direct' && firstHintEl) {
+    noteLearned('direct-drag');
+    firstHintEl.dataset.probeStep = '';
+  }
+};
+let probeDirectDown = null;
+renderer.domElement.addEventListener('pointerdown', ev => {
+  probeDirectDown = { x: ev.clientX, y: ev.clientY };
+}, { passive: true });
+renderer.domElement.addEventListener('pointerup', ev => {
+  if (!probeDirectDown || !firstHintEl || firstHintEl.hidden || firstHintEl.dataset.probeStep !== 'direct') return;
+  const moved = Math.hypot(ev.clientX - probeDirectDown.x, ev.clientY - probeDirectDown.y);
+  const hasSelection = App.selectedObjectIds.size || App.selectedElements.size;
+  if (moved > 12 && hasSelection) dismissFirstHint(true);
+  probeDirectDown = null;
+}, { passive: true });
 </script>
 </body>
 </html>
