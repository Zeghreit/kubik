 }
 html.uv2d-open #matFly, html.uv2d-open #symAxes, html.uv2d-open #toolChip,
 html.uv2d-open #selMarks, html.uv2d-open #isoChip, html.uv2d-open #lightHud,
+/* Graphic state pass: selection is a solid mineral surface, not another
+   translucent tint. The mode block, open shelf handles and the chosen row
+   now share one visual grammar; mode colour remains on the working tools. */
+#outFly.open #outTab,
+#matFly.open #matTab {
+  color: #111315; background: #f5f5f2; border-color: #f5f5f2;
+}
+#outFly.open #outTab::before,
+#matFly.open #matTab::before { color: rgb(17 19 21 / .58); }
+#outFly.open #outTab::after,
+#matFly.open #matTab::after { background: #111315; }
+#outFly.open .tabName,
+#matFly.open .tabName { color: #111315; }
+.outRow.selected {
+  color: #111315; background: #f5f5f2; border-color: transparent;
+  border-radius: 0; box-shadow: none; clip-path: var(--cut);
+}
+.outRow.selected .outEye,
+.outRow.selected .outCaret,
+.outRow.selected.is-hidden .outEye { color: #111315; opacity: .72; }
+.outRow.selected .outCount { color: #111315; background: rgb(17 19 21 / .09); }
+/* A drop target is a transient operation state and outranks selection. */
+.outRow.selected.outDropInto {
+  color: var(--text); border-color: var(--accent);
+  background: linear-gradient(var(--accent-dim), var(--accent-dim)), var(--panel);
+  box-shadow: inset 0 0 0 var(--rule) var(--accent);
+}
+/* Materials reads as a specimen shelf: no stack of little dark buttons.
+   Larger rendered spheres carry the surface; quiet rules separate the rest. */
+#matTrayInner { gap: 0; padding: 8px; }
+.mat-card {
+  width: 72px; gap: 4px; padding: 8px 4px 9px;
+  border: 0; border-bottom: var(--rule) solid var(--hair);
+  border-radius: 0; background: transparent; clip-path: none;
+}
+.mat-card img { width: 54px; height: 54px; }
+.mat-card.active {
+  color: #111315; background: #f5f5f2; border-color: transparent;
+  clip-path: var(--cut);
+}
+.mat-card.active span:not(.mat-edit) { color: #111315; font-weight: 500; }
+.mat-card.add, .mat-card.sweep { background: transparent; }
 html.uv2d-open #softHud, html.uv2d-open #firstHint { display: none !important; }
 html.uv2d-open #outFly { display: flex; }
